---
/**
 * StatusBar — iOS-style status bar, 54px, matches the Figma component.
 * Purely decorative.
 */
---

<div class="status-bar" aria-hidden="true">
  <span class="status-time">9:41</span>
  <div class="status-icons">
    <svg width="18" height="12" viewBox="0 0 17 12" fill="currentColor" aria-hidden="true">
      <rect x="0" y="8" width="3.2" height="4" rx="0.6" />
      <rect x="4.4" y="5.5" width="3.2" height="6.5" rx="0.6" />
      <rect x="8.8" y="3" width="3.2" height="9" rx="0.6" />
      <rect x="13.2" y="0" width="3.2" height="12" rx="0.6" />
    </svg>
    <svg
      width="17"
      height="12"
      viewBox="0 0 16 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M1.2 4.4C4 1.6 12 1.6 14.8 4.4" />
      <path d="M3.7 6.8C5.6 4.9 10.4 4.9 12.3 6.8" />
      <path d="M6.1 9.1C7 8.2 9 8.2 9.9 9.1" />
      <circle cx="8" cy="11.2" r="0.9" fill="currentColor" stroke="none" />
    </svg>
    <svg width="26" height="12" viewBox="0 0 26 12" aria-hidden="true">
      <rect
        x="0.5"
        y="0.5"
        width="22"
        height="11"
        rx="3.4"
        fill="none"
        stroke="currentColor"
        stroke-opacity="0.35"
      />
      <rect x="23" y="4" width="2" height="4" rx="1" fill="currentColor" fill-opacity="0.35" />
      <rect x="2" y="2" width="18" height="8" rx="2.2" fill="currentColor" />
    </svg>
  </div>
</div>
